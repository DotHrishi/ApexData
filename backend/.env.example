# =============================================================
# ApexData Backend — Environment Variables
# =============================================================
# Copy this file to .env for local development
# Set these in Render / Railway environment variables for production

# Port to run the Express server on
PORT=5000

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=<AppName>

# NewsData.io API key (https://newsdata.io)
NEWS_API_KEY=<your_newsdata_io_api_key>

# URL of the deployed FastAPI AI Agent (XGBoost Strategy Engine)
# Example: https://apexdata-ai-agent.onrender.com/strategy/recommend
PYTHON_AI_URL=http://localhost:8000/strategy/recommend

# Comma-separated list of allowed CORS origins in production
# Example: https://apexdata.vercel.app,https://www.apexdata.io
# Leave unset to allow all origins (development only)
ALLOWED_ORIGINS=

# FastAPI AI Agent base URL (XGBoost Strategy Engine)
VITE_AI_AGENT_URL=http://localhost:8000

# FastAPI F1 Strategy AI URL (Pit Wall Analyzer Pro)
VITE_STRATEGY_AI_URL=http://localhost:8001

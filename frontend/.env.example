# =============================================================
# ApexData Frontend — Environment Variables
# =============================================================
# For local development:
#   cp .env.example .env.local   (never commit .env.local)
#
# For production (Vercel):
#   Add each variable in Project Settings → Environment Variables.
#   The build WILL NOT fall back to localhost; missing variables
#   will cause API calls to fail, so all three must be set.
# =============================================================

# Express backend base URL — your Render service URL (no trailing slash)
# Example: https://apexdata-backend.onrender.com
VITE_BACKEND_URL=

# FastAPI AI Agent base URL — XGBoost Strategy Engine on Render
# Example: https://apexdata-ai-agent.onrender.com
VITE_AI_AGENT_URL=

# FastAPI F1 Strategy AI URL — Pit Wall Analyzer Pro on Render
# Example: https://apexdata-f1-strategy-ai.onrender.com
VITE_STRATEGY_AI_URL=
